{
  "name": "github-model-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:units && npm run test:render",
    "test:units": "esbuild tests/units.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/units.mjs --log-level=warning && node node_modules/.cache/units.mjs",
    "test:render": "node tests/run-render.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "three": "^0.182.0"
  }
}
